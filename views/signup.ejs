<h1>Sign up</h1>

<form action="/authenticate/signup/add" method="POST">
    <div>
        <label for="name">Name</label>
        <input id="name" name="name" type="text" maxlength="255" autocomplete="name" required>
    </div>

    <div>
        <label for="email">Email</label>
        <input id="email" name="email" type="email" maxlength="255" autocomplete="email" required>
    </div>

    <div>
        <label for="password">Password</label>
        <input id="password" name="password" type="password" maxlength="255" autocomplete="new-password" required>
    </div>

    <div>
        <label for="role">Account type</label>
        <select id="role" name="role" required>
            <option value="guest" selected>Guest</option>
            <option value="host">Host</option>
        </select>
    </div>

    <button type="submit">Create account</button>
</form>