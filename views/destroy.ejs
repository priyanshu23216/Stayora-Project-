<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wrong Password</title>
    <link rel = 'stylesheet' href = '/css/warning.css'>
</head>
<body>
    <div class="wrong-password" id="successPopup">
    <div class="wrong">

        <div class="warning-icon">
            <span>❌</span>
        </div>

        <h2>Are you Sure?</h2>

        <p>Your Listing will permanently be Deleted</p>

        <form method = "POST" action = '/stayora/list/delete/<%= id %>?_method=DELETE'>
            <button type="submit">Yes , Delete this Listing</button>
        </form>

    </div>
</body>
</html>