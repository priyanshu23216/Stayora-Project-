    
    <div class="listings-container">

    <% for (let key of result) { %>

        <div class="listing-card">

            <img src="<%= key.IMAGE %>" alt="Listing Image">

            <h2><%= key.TITLE %></h2>

            <p><%= key.DESCRIPTION %></p>

            <p><%= key.LOCATION %>, <%= key.COUNTRY %></p>

            <h3>₹<%= key.PRICE %> / night</h3>

            <form method="GET" action="/stayora/listing/<%= key.ID %>">
                <button type="submit">View More</button>
            </form>

        </div>

    <% } %>

</div>

