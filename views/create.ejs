
    <h1>Enter Your Details</h1>

    <form action="/stayora/listing/add" method="POST">

        <h4 class="mandatory-notice">
            Fields marked with <span>*</span> are mandatory
        </h4>

        <label for="id">Listing ID</label>
        <input type="text" id="id" name="ID" placeholder="This will be generated by the system" disabled>

        <label for="password" class="required">Password</label>
        <input type="password" id="password" name="PASSWORD" placeholder="Enter Strong Password" required>

        <label for="title" class="required">Title</label>
        <input type="text" id="title" name="TITLE" placeholder="Enter the Title for your Property" required>

        <label for="description" class="required">Description</label>
        <textarea id="description" name="DESCRIPTION" placeholder="How will you describe your place for Tourists" required></textarea>

        <label for="image">Image URL</label>
        <input type="url" id="image" name="IMAGE" placeholder="Upload a photo of your place">

        <label for="price" class="required">Price</label>
        <input type="number" id="price" name="PRICE" min="1" max="10000" placeholder="Enter Price per night for your Place" required>

        <label for="location" class="required">Location</label>
        <input type="text" id="location" name="LOCATION" placeholder="Enter Location of your Place" required>

        <label for="country" class="required">Country</label>
        <input type="text" id="country" name="COUNTRY" placeholder="Enter Country" required>

        <button type="submit">Create Listing</button>

    </form>
