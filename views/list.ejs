
    <h1><%= result[0].TITLE %></h1>
        <ol>
            <li><%= result[0].DESCRIPTION %></li>
            <li><img src ='<%= result[0].IMAGE %>' alt = "List Image" width = "500"></li>
            <li> Price - ₹<%= result[0].PRICE %>/night</li>
            <li>Location - <%= result[0].LOCATION %></li>
            <li>Country - <%= result[0].COUNTRY %></li>
            <li>
                <form method = 'GET' action = '/stayora/listing/edit/<%= result[0].ID %>'>
                <button type="submit">Edit</button>
            </form>
            </li>
            <li>
                <form method = 'GET' action = '/stayora/listing/delete/<%= result[0].ID %>'>
                <button type="submit">Delete</button>
            </form>
            </li>
        </ol>

