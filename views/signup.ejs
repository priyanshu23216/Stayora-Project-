<h1>Sign up</h1>

<form action="/authenticate/signup/add" method="POST">
    <div>
        <label for="name">Name</label>
        <input id="name" name="name" type="text" maxlength="255" autocomplete="name" required>
        <span class="error-name" style="color: #e53e3e; display: block; margin-top: 5px; font-size: 13px;"></span>
    </div>

    <div>
        <label for="email">Email</label>
        <input id="email" name="email" type="email" maxlength="255" autocomplete="email" required>
        <span class="error-email" style="color: #e53e3e; display: block; margin-top: 5px; font-size: 13px;"></span>
    </div>

    <div>
        <label for="password">Password</label>
        <input id="password" name="password" type="password" maxlength="255" placeholder = "Enter Strong Password " autocomplete="new-password" required>
        <span class="error-password" style="color: #e53e3e; display: block; margin-top: 5px; font-size: 13px;"></span>
    </div>

    <button type="submit">Create account</button>
</form>

<hr style="margin: 20px 0;">

<div>
    <a href="/authenticate/google" style="display: inline-block; padding: 10px 16px; border: 1px solid #ddd; border-radius: 6px; text-decoration: none; font-weight: 500; color: #333;">
        <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google" style="width: 18px; vertical-align: middle; margin-right: 8px;">
        Continue with Google
    </a>
</div>
<script src = "../js/signupValidate.js"></script>
