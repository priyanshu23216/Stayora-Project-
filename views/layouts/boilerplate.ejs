<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stayora <%= title %></title>
</head>
<body>
    <%- include('../partials/navbar.ejs') %>

    <% if (success && success.length > 0) { %>
        <div style="background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; padding: 12px 20px; margin: 15px auto; width: 90%; border-radius: 6px;">
            <%= success %>
        </div>
    <% } %>
    <% if (error && error.length > 0) { %>
        <div style="background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; padding: 12px 20px; margin: 15px auto; width: 90%; border-radius: 6px;">
            <%= error %>
        </div>
    <% } %>
    
        <%- body %>

    <%- include('../partials/footer.ejs') %>
    
</body>
</html>