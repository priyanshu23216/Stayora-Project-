<h1>Verify your email</h1>

<p>Enter the six-digit code sent to <strong><%= email %></strong>.</p>

<form action="/authenticate/signup/verify-otp" method="POST">
	<input type="hidden" name="email" value="<%= email %>">

	<div>
		<label for="otp">Verification code</label>
		<input
			id="otp"
			name="otp"
			type="text"
			inputmode="numeric"
			autocomplete="one-time-code"
			pattern="[0-9]{6}"
			minlength="6"
			maxlength="6"
			required
		>
	</div>

	<button type="submit">Verify email</button>
</form>

<form action="/authenticate/signup/resend-otp" method="POST">
	<input type="hidden" name="email" value="<%= email %>">
	<p id="resend-countdown-message">
		You can request another code in <span id="resend-countdown">60</span> seconds.
	</p>
	<button id="resend-otp-button" type="submit" hidden>Resend code</button>
</form>
<script src = '../js/resendOTP.js'></script>


